+\cs_generate_variant:Nn \clist_if_in:NnTF { NV }
+\cs_generate_variant:Nn \tl_lower_case:n { V }
+
+\cs_new_protected:Npn \abnt_citetitle_abbrev:n #1
+  {
+    \tl_set:Nn \l__abnt_citetitle_main_tl {#1}
+    % Subtitles do not enter the authorless citation key.
+    \regex_replace_once:nnN { \s* : \s* .* \Z } { } \l__abnt_citetitle_main_tl
+    \regex_replace_once:nnN { [.,;]+ \s* \Z } { } \l__abnt_citetitle_main_tl
+    \seq_set_split:NnV \l__abnt_citetitle_words_seq { ~ } \l__abnt_citetitle_main_tl
+    \seq_remove_all:Nn \l__abnt_citetitle_words_seq { }
+    \int_compare:nNnTF { \seq_count:N \l__abnt_citetitle_words_seq } = { 1 }
+      {
+        \seq_pop_left:NN \l__abnt_citetitle_words_seq \l__abnt_citetitle_first_tl
+        \exp_args:NV \MakeCapital \l__abnt_citetitle_first_tl
+      }
+      {
+        \seq_pop_left:NN \l__abnt_citetitle_words_seq \l__abnt_citetitle_first_tl
+        \tl_set:Nx \l__abnt_citetitle_first_lower_tl
+          { \tl_lower_case:V \l__abnt_citetitle_first_tl }
+        \exp_args:NV \MakeCapital \l__abnt_citetitle_first_tl
+        \clist_if_in:NVTF \c__abnt_citetitle_leads_clist
+          \l__abnt_citetitle_first_lower_tl
+          {
+            \seq_if_empty:NF \l__abnt_citetitle_words_seq
+              {
+                \c_space_tl
+                \seq_pop_left:NN \l__abnt_citetitle_words_seq \l_tmpa_tl
+                \tl_use:N \l_tmpa_tl
+              }
+          }
+          { }
+        \seq_if_empty:NF \l__abnt_citetitle_words_seq
+          { \c_space_tl \mbox{[...]} }
+      }
+  }
+\cs_set_eq:NN \ABNTEXciteTitleAbbrev \abnt_citetitle_abbrev:n
