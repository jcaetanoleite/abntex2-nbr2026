-% Get first word >>>3
-\newcommand\FirstWord[1]{\@firstword#1 \@nil}%
-\def\@firstword#1 #2\@nil{\@removecomma#1,\@nil}%
-\def\@removecomma#1,#2\@nil{\@removeperiod#1.\@nil}%
