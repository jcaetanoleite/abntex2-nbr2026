% ABNT NBR 6028:2021, 4.1.7 — palavras-chave abaixo do resumo, rótulo
% seguido de dois-pontos, termos separados por ponto e vírgula e ponto final.
% A grafia dos termos é preservada para não corromper nomes próprios/científicos.
\providecommand{\ABNTEXkeywordname}{Palavras-chave}
\providecommand{\palavraschave}[2][\ABNTEXkeywordname]{%
  \par\vspace{\onelineskip}%
  \noindent\textbf{#1}: #2\unskip.\par%
}
\providecommand{\keywords}[1]{\palavraschave[Keywords]{#1}}

